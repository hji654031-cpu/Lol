-- МОБИЛЬНАЯ ЛОГИКА ПОЛЕТА (ЧЕРЕЗ ИГРОВОЙ ДЖОЙСТИК)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Получение модуля управления джойстиком
local PlayerModule = require(LocalPlayer.PlayerScripts:WaitForChild("PlayerModule"))
local Controls = PlayerModule:GetControls()

local flying = false
local speed = 40

SpeedInput.FocusLost:Connect(function()
    local num = tonumber(SpeedInput.Text)
    if num then speed = num else SpeedInput.Text = tostring(speed) end
end)

local function Fly()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:WaitForChild("Humanoid")
    
    local bv = Instance.new("BodyVelocity")
    local bg = Instance.new("BodyGyro")
    
    bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.velocity = Vector3.new(0, 0, 0)
    bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.cframe = root.CFrame
    
    bv.Parent = root
    bg.Parent = root
    
    -- Перевод персонажа в режим физики во избежание багов
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    
    local render_conn
    render_conn = RunService.RenderStepped:Connect(function()
        if not flying or not root.Parent then
            bv:Destroy()
            bg:Destroy()
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            render_conn:Disconnect()
            return
        end
        
        bg.cframe = Camera.CFrame
        
        -- Считываем вектор смещения виртуального джойстика
        local moveVector = Controls:GetMoveVector()
        
        if moveVector.Magnitude > 0 then
            -- Вычисляем правильный ход движения вперед/назад и влево/вправо на основе камеры
            local moveX = Camera.CFrame.RightVector * moveVector.X
            local moveZ = Camera.CFrame.LookVector * -moveVector.Z
            
            local finalVector = (moveX + moveZ).Unit
            bv.velocity = finalVector * speed
        else
            -- Стабильное зависание в воздухе при отпущенном стике
            bv.velocity = Vector3.new(0, 0, 0)
        end
    end)
end

FlyButton.MouseButton1Click:Connect(function()
    flying = not flying
    if flying then
        FlyButton.Text = "Fly: ON"
        FlyButton.TextColor3 = Color3.fromRGB(160, 32, 240)
        Fly()
    else
        FlyButton.Text = "Fly: OFF"
        FlyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end)
